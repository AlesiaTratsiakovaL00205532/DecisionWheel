{
  "name": "decision-wheel",
  "version": "1.0.0",
  "private": true,
  "description": "A decision wheel with a browser-only question history.",
  "type": "module",
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "start": "node src/server.js",
    "dev": "node --watch src/server.js",
    "lint": "eslint . --max-warnings=0",
    "test": "node --test \"tests/unit/*.test.js\" \"tests/integration/*.test.js\"",
    "test:ci": "node --test --test-reporter=spec --test-reporter=junit --test-reporter-destination=stdout --test-reporter-destination=reports/unit-integration.xml \"tests/unit/*.test.js\" \"tests/integration/*.test.js\"",
    "test:browser": "playwright test"
  },
  "dependencies": {
    "express": "^5.1.0"
  },
  "overrides": {
    "minimatch": "^11.0.6"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@playwright/test": "^1.56.0",
    "eslint": "^10.14.0",
    "globals": "^17.14.0",
    "supertest": "^7.1.4"
  }
}
