{
  "uid": "decision-wheel",
  "title": "DecisionWheel",
  "schemaVersion": 39,
  "version": 1,
  "editable": false,
  "refresh": "5s",
  "time": { "from": "now-15m", "to": "now" },
  "links": [
    { "title": "Prometheus alerts", "url": "http://127.0.0.1:9090/alerts", "targetBlank": true },
    { "title": "Alertmanager", "url": "http://127.0.0.1:9093", "targetBlank": true }
  ],
  "panels": [
    {
      "id": 1, "type": "stat", "title": "Healthy app targets (expected: 2)",
      "gridPos": { "x": 0, "y": 0, "w": 8, "h": 4 },
      "datasource": { "type": "prometheus", "uid": "decision-wheel-prometheus" },
      "targets": [{ "refId": "A", "expr": "sum(up{job=\"decision-wheel\"}) or vector(0)", "instant": true }]
    },
    {
      "id": 2, "type": "stat", "title": "Requests since app process start",
      "gridPos": { "x": 8, "y": 0, "w": 8, "h": 4 },
      "datasource": { "type": "prometheus", "uid": "decision-wheel-prometheus" },
      "targets": [{ "refId": "A", "expr": "sum(decision_wheel_http_requests_total{job=\"decision-wheel\"}) or vector(0)", "instant": true }]
    },
    {
      "id": 3, "type": "stat", "title": "Firing alerts",
      "gridPos": { "x": 16, "y": 0, "w": 8, "h": 4 },
      "datasource": { "type": "prometheus", "uid": "decision-wheel-prometheus" },
      "targets": [{ "refId": "A", "expr": "count(ALERTS{alertstate=\"firing\"}) or vector(0)", "instant": true }]
    },
    {
      "id": 4, "type": "timeseries", "title": "Requests per second by fixed route",
      "gridPos": { "x": 0, "y": 4, "w": 12, "h": 8 },
      "datasource": { "type": "prometheus", "uid": "decision-wheel-prometheus" },
      "targets": [{ "refId": "A", "expr": "sum by (route) (rate(decision_wheel_http_requests_total{job=\"decision-wheel\"}[1m]))", "legendFormat": "{{route}}" }],
      "fieldConfig": { "defaults": { "unit": "reqps", "min": 0 } }
    },
    {
      "id": 5, "type": "timeseries", "title": "Client/server errors and interruptions per second",
      "gridPos": { "x": 12, "y": 4, "w": 12, "h": 8 },
      "datasource": { "type": "prometheus", "uid": "decision-wheel-prometheus" },
      "targets": [{ "refId": "A", "expr": "sum by (status) (rate(decision_wheel_http_errors_total{job=\"decision-wheel\"}[1m]))", "legendFormat": "{{status}}" }],
      "fieldConfig": { "defaults": { "unit": "reqps", "min": 0 } }
    },
    {
      "id": 6, "type": "timeseries", "title": "API latency (p50 and p95)",
      "gridPos": { "x": 0, "y": 12, "w": 12, "h": 8 },
      "datasource": { "type": "prometheus", "uid": "decision-wheel-prometheus" },
      "targets": [
        { "refId": "A", "expr": "histogram_quantile(0.5, sum by (le) (rate(decision_wheel_http_request_duration_seconds_bucket{job=\"decision-wheel\",route=\"/api/spin\"}[1m])))", "legendFormat": "p50" },
        { "refId": "B", "expr": "histogram_quantile(0.95, sum by (le) (rate(decision_wheel_http_request_duration_seconds_bucket{job=\"decision-wheel\",route=\"/api/spin\"}[1m])))", "legendFormat": "p95" }
      ],
      "fieldConfig": { "defaults": { "unit": "s", "min": 0 } }
    },
    {
      "id": 7, "type": "timeseries", "title": "Firing alert history",
      "gridPos": { "x": 12, "y": 12, "w": 12, "h": 8 },
      "datasource": { "type": "prometheus", "uid": "decision-wheel-prometheus" },
      "targets": [{ "refId": "A", "expr": "ALERTS{alertstate=\"firing\"}", "legendFormat": "{{alertname}}" }],
      "fieldConfig": { "defaults": { "min": 0 } }
    }
  ]
}
